{-# OPTIONS --safe --without-K #-}

-- `IsMeasureMonad cm`: a commutative monad generated by probes.  Every global element of the monad is the push-forward
-- of a measure on ℛ along a probe, and `pushforward a μ` is that push-forward.  No normalisation is imposed: global
-- elements are measures of arbitrary total mass.  Adding `affine` gives a probability monad: `QBS.Monad.Probability`,
-- and whose inclusion in a measure monad is a `StrongMonad⇒` (`Categories.Monad.Morphism.Strong`).
-- `MeasureMonad` bundles a commutative monad with `IsMeasureMonad`.
--
-- Source: Heunen–Kammar–Staton–Yang (arXiv:1701.02547), Def. 10 and §V.D (`P X` is the set of classes `[α, μ]` of a
-- random element and a measure on R, modulo equal push-forward).
-- Divergences, deliberate: a measure on ℛ is a global element `⊤ ⇒ T ℛ`, with no separate set of measures; and
-- `generated` lets the measure range over all of `⊤ ⇒ T ℛ`, which is weaker than ranging over a chosen subset, and
-- is required only for inhabited `X` (so that a zero measure on the empty space is not excluded).
open import Categories.Category.Core using (Category)
import Categories.Category.CartesianClosed.Canonical as Canonical

module QBS.Monad.Measure
  {o h e} {C : Category o h e}
  (ℛ : Category.Obj C)
  (CC : Canonical.CartesianClosed C)
  where

open import Level using (_⊔_)
open import Data.Product.Base using (Σ)

open import Categories.Category using (_[_,_])
open import Categories.Category.Construction.Kleisli using (Kleisli)
open import Categories.Monad using (Monad)
import Categories.Monad.Notation as Notation
open import Categories.Monad.Commutative using (CommutativeMonad)
open import Categories.Monad.Strong using (StrongMonad)
import Categories.Morphism.Reasoning as MR

open import Categories.Monad.Commutative.Cartesian using (CartCommMonad)

-- (`MeasureMonad`, the bundle, follows `IsMeasureMonad`)
record IsMeasureMonad (cm : CartCommMonad CC) : Set (o ⊔ h ⊔ e) where
  open Category C
  open Canonical.CartesianClosed CC using (⊤; !)
  private
    module T = Notation (CommutativeMonad.M cm)
    -- the Kleisli category of the monad: `K [ X , Y ]` is `X ⇒ T Y`
    K = Kleisli (CommutativeMonad.M cm)

  -- a measure on `X` is a global element of the monad, a Kleisli arrow `⊤ → X`; a measure on ℛ:
  ℛ-Measure : Set h
  ℛ-Measure = K [ ⊤ , ℛ ]

  -- the push-forward `a_* μ` of a measure along a probe `a : ℛ ⇒ X` (HKSY §V.C): the image of `μ` under `T a`
  pushforward : ∀ {X} → (ℛ ⇒ X) → ℛ-Measure → K [ ⊤ , X ]
  pushforward a μ = T.₁ a ∘ μ

  field
    -- every measure on an inhabited `X` is the push-forward of a measure on ℛ along a probe (HKSY Def. 10).  `X` must be
    -- inhabited (`x : ⊤ ⇒ X`): the zero measure on the initial object `0` would need a probe `ℛ ⇒ 0`, which does not exist
    -- (in QBS there is no map ℝ → ∅; in general it would force ℛ ≅ 0).  HKSY avoid this as their measures are nonzero.
    generated
      : ∀ {X} (x : ⊤ ⇒ X) (t : K [ ⊤ , X ])
      → Σ (ℛ ⇒ X) λ a → Σ ℛ-Measure λ μ → pushforward a μ ≈ t

-- a measure monad: a commutative monad with the property `IsMeasureMonad` (as `Monoid` and `IsMonoid`)
record MeasureMonad : Set (o ⊔ h ⊔ e) where
  field
    commutativeMonad : CartCommMonad CC
    isMeasure : IsMeasureMonad commutativeMonad

  -- the underlying monad
  monad : Monad C
  monad = CommutativeMonad.M commutativeMonad

  -- the underlying strong monad
  strongMonad : StrongMonad _
  strongMonad = CommutativeMonad.strongMonad commutativeMonad

  open IsMeasureMonad isMeasure public
