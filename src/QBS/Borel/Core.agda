{-# OPTIONS --safe --without-K #-}

-- The Borel σ-algebra on Cantor space 2^ℕ, generated by the sets {x | x n = b}, and the
-- measurable maps Cantor → Cantor (Billingsley, *Probability and Measure*, §1–§2 and §13;
-- the topology of 2^ℕ is generated by the same sets, so this is its Borel σ-algebra).
--
-- A set is a predicate `Cantor → Set`.  The σ-algebra is an inductive predicate on sets,
-- closed under complement, countable unions and countable intersections (taking all three
-- as primitives avoids De Morgan, hence classical logic) and under pointwise logical
-- equivalence (there is no propositional extensionality).
module QBS.Borel.Core where

open import Level using (Level)
open import Function.Base using (id; _∘_; const)
open import Data.Bool.Base using (Bool; true; false)
open import Data.Bool.Properties using (_≟_)
open import Data.Nat.Base using (ℕ; zero; suc)
open import Data.Empty using (⊥; ⊥-elim)
open import Data.Unit.Base using (⊤; tt)
open import Data.Product.Base using (Σ; _,_; _×_; proj₁; proj₂)
open import Data.Sum.Base using (_⊎_; inj₁; inj₂)
open import Relation.Nullary using (Dec; yes; no)
open import Relation.Binary.PropositionalEquality.Core using (_≡_; _≗_; refl; sym; trans; cong; subst)

Cantor : Set
Cantor = ℕ → Bool

Pred : Set₁
Pred = Cantor → Set

-- pointwise logical equivalence of sets
_≐_ : Pred → Pred → Set
U ≐ V = ∀ x → (U x → V x) × (V x → U x)

data Borel : Pred → Set₁ where
  gen   : ∀ n b → Borel (λ x → x n ≡ b)
  compl : ∀ {U} → Borel U → Borel (λ x → U x → ⊥)
  ⋃     : ∀ {U : ℕ → Pred} → (∀ n → Borel (U n)) → Borel (λ x → Σ ℕ (λ n → U n x))
  ⋂     : ∀ {U : ℕ → Pred} → (∀ n → Borel (U n)) → Borel (λ x → ∀ n → U n x)
  resp  : ∀ {U V} → U ≐ V → Borel U → Borel V

-- f is measurable when preimages of the generating sets are Borel
Measurable : (Cantor → Cantor) → Set₁
Measurable f = ∀ n b → Borel (λ x → f x n ≡ b)

-- preimages of Borel sets are Borel
preimage : ∀ {f U} → Measurable f → Borel U → Borel (λ x → U (f x))
preimage mf (gen n b) = mf n b
preimage mf (compl bu) = compl (preimage mf bu)
preimage mf (⋃ bu) = ⋃ (λ n → preimage mf (bu n))
preimage mf (⋂ bu) = ⋂ (λ n → preimage mf (bu n))
preimage mf (resp e bu) = resp (λ x → e (_)) (preimage mf bu)

measurable-id : Measurable id
measurable-id = gen

measurable-∘ : ∀ {f g} → Measurable f → Measurable g → Measurable (g ∘ f)
measurable-∘ mf mg n b = preimage mf (mg n b)

-- binary unions and intersections
bin : Pred → Pred → ℕ → Pred
bin U V zero = U
bin U V (suc _) = V

bin-borel : ∀ {U V} → Borel U → Borel V → ∀ n → Borel (bin U V n)
bin-borel bu bv zero = bu
bin-borel bu bv (suc _) = bv

union₂ : ∀ {U V} → Borel U → Borel V → Borel (λ x → U x ⊎ V x)
union₂ {U} {V} bu bv = resp e (⋃ (bin-borel bu bv))
  where
    e : (λ x → Σ ℕ (λ n → bin U V n x)) ≐ (λ x → U x ⊎ V x)
    e x = (λ { (zero , u) → inj₁ u ; (suc _ , v) → inj₂ v })
        , (λ { (inj₁ u) → zero , u ; (inj₂ v) → suc zero , v })

inter₂ : ∀ {U V} → Borel U → Borel V → Borel (λ x → U x × V x)
inter₂ {U} {V} bu bv = resp e (⋂ (bin-borel bu bv))
  where
    e : (λ x → ∀ n → bin U V n x) ≐ (λ x → U x × V x)
    e x = (λ h → h zero , h (suc zero))
        , (λ { (u , v) → λ { zero → u ; (suc _) → v } })

-- the whole space and the empty set
⊤-borel : Borel (λ _ → ⊤)
⊤-borel = resp e (union₂ (gen zero true) (compl (gen zero true)))
  where
    e : (λ x → (x zero ≡ true) ⊎ ((x zero ≡ true) → ⊥)) ≐ (λ _ → ⊤)
    e x = (λ _ → tt) , (λ _ → dec (x zero))
      where
        dec : ∀ b → (b ≡ true) ⊎ ((b ≡ true) → ⊥)
        dec true = inj₁ refl
        dec false = inj₂ (λ ())

⊥-borel : Borel (λ _ → ⊥)
⊥-borel = resp (λ x → (λ f → f tt) , (λ b _ → b)) (compl ⊤-borel)

-- constant maps are measurable
measurable-const : ∀ c → Measurable (const c)
measurable-const c n b with c n ≟ b
... | yes p = resp (λ x → (λ _ → p) , (λ _ → tt)) ⊤-borel
... | no ¬p = resp (λ x → (λ ()) , (λ e → ¬p e)) ⊥-borel

-- Borel sets do not distinguish points that agree everywhere (`_≗_`, pointwise equality of sequences)
borel-≗ : ∀ {U} → Borel U → ∀ {x y} → x ≗ y → (U x → U y) × (U y → U x)
borel-≗ (gen n b) e = (λ p → trans (sym (e n)) p) , (λ p → trans (e n) p)
borel-≗ (compl bu) e = (λ f v → f (proj₂ (borel-≗ bu e) v)) , (λ f u → f (proj₁ (borel-≗ bu e) u))
borel-≗ (⋃ bu) e = (λ { (n , u) → n , proj₁ (borel-≗ (bu n) e) u }) , (λ { (n , v) → n , proj₂ (borel-≗ (bu n) e) v })
borel-≗ (⋂ bu) e = (λ f n → proj₁ (borel-≗ (bu n) e) (f n)) , (λ f n → proj₂ (borel-≗ (bu n) e) (f n))
borel-≗ (resp ee bu) {x} {y} e =
  (λ v → proj₁ (ee y) (proj₁ (borel-≗ bu e) (proj₂ (ee x) v)))
  , (λ v → proj₁ (ee x) (proj₂ (borel-≗ bu e) (proj₂ (ee y) v)))

-- measurable maps respect `_≗_`
measurable-≗ : ∀ {f} → Measurable f → ∀ {x y} → x ≗ y → f x ≗ f y
measurable-≗ {f} mf {x} {y} e n = sym (proj₁ (borel-≗ (mf n (f x n)) e) refl)

-- measurability depends only on values
measurable-ext : ∀ {f g} → (∀ x → f x ≗ g x) → Measurable f → Measurable g
measurable-ext e mf n b = resp (λ x → (λ p → trans (sym (e x n)) p)
                                    , (λ p → trans (e x n) p)) (mf n b)

-- countable partitions: j : Cantor → ℕ with Borel fibres
Partition : (Cantor → ℕ) → Set₁
Partition j = ∀ k → Borel (λ x → j x ≡ k)

-- gluing measurable maps along a measurable countable partition
measurable-glue : ∀ {j : Cantor → ℕ} {f : ℕ → Cantor → Cantor} →
  Partition j → (∀ k → Measurable (f k)) → Measurable (λ x → f (j x) x)
measurable-glue {j} {f} pj mf n b = resp e (⋃ (λ k → inter₂ (pj k) (mf k n b)))
  where
    e : (λ x → Σ ℕ (λ k → (j x ≡ k) × (f k x n ≡ b))) ≐ (λ x → f (j x) x n ≡ b)
    e x = (λ { (k , p , q) → subst (λ k′ → f k′ x n ≡ b) (sym p) q })
        , (λ q → j x , refl , q)
