{-# OPTIONS --safe --without-K #-}

-- Dynkin's π–λ theorem for the Borel σ-algebra of Cantor space (Billingsley, Thm. 3.2): any
-- class of sets that contains the finite cylinder intersections (a π-system) and is closed under
-- complement and countable disjoint unions contains every Borel set.  Classical: it uses `lem`.
module QBS.Borel.PiLambda where

open import Level using (Level)
open import Function.Base using (id; _∘_; const)
open import Data.Bool.Base using (Bool; true; false)
open import Data.Nat.Base using (ℕ; zero; suc)
import Data.Nat.Base as ℕ
import Data.Nat.Properties as ℕₚ
import Data.Nat.Induction
open import Data.Empty using (⊥; ⊥-elim)
open import Data.Unit.Base using (⊤; tt)
open import Data.Product.Base using (Σ; _,_; _×_; proj₁; proj₂)
open import Data.Sum.Base using (_⊎_; inj₁; inj₂)
open import Relation.Binary.Definitions using (tri<; tri≈; tri>)
import Relation.Binary.PropositionalEquality.Core as ≡
open ≡ using (_≡_)

open import QBS.Borel.Core
open import QBS.Borel.Measure using (Disjoint)
open import QBS.Classical using (LEM₀)

-- operations on sets
_∩ᵖ_ : Pred → Pred → Pred
U ∩ᵖ V = λ x → U x × V x

∁ : Pred → Pred
∁ U = λ x → U x → ⊥

⊤ᵖ ⊥ᵖ : Pred
⊤ᵖ = λ _ → ⊤
⊥ᵖ = λ _ → ⊥

≐-refl : ∀ {U} → U ≐ U
≐-refl x = (λ u → u) , (λ u → u)

≐-sym : ∀ {U V} → U ≐ V → V ≐ U
≐-sym e x = proj₂ (e x) , proj₁ (e x)

≐-trans : ∀ {U V W} → U ≐ V → V ≐ W → U ≐ W
≐-trans e f x = (λ u → proj₁ (f x) (proj₁ (e x) u)) , (λ w → proj₂ (e x) (proj₂ (f x) w))

-- the π-system of finite cylinder intersections
data Cyl : Pred → Set₁ where
  cylTop : Cyl ⊤ᵖ
  cylAnd : ∀ {U} → Cyl U → (n : ℕ) (b : Bool) → Cyl (λ x → U x × (x n ≡ b))
  cylResp : ∀ {U V} → U ≐ V → Cyl U → Cyl V

Cyl-∩ : ∀ {U V} → Cyl U → Cyl V → Cyl (U ∩ᵖ V)
Cyl-∩ {U} cU cylTop = cylResp (λ x → (λ u → u , tt) , (λ (u , _) → u)) cU
Cyl-∩ {U} cU (cylAnd {V} cV n b) =
  cylResp (λ x → (λ ((u , v) , e) → u , v , e) , (λ (u , v , e) → (u , v) , e)) (cylAnd (Cyl-∩ cU cV) n b)
Cyl-∩ {U} cU (cylResp {V} {V′} e cV) =
  cylResp (λ x → (λ (u , v) → u , proj₁ (e x) v) , (λ (u , v′) → u , proj₂ (e x) v′)) (Cyl-∩ cU cV)

module Dynkin (lem : LEM₀) where

  -- the λ-system generated by the cylinders
  data Lam : Pred → Set₁ where
    lcyl : ∀ {U} → Cyl U → Lam U
    lcompl : ∀ {U} → Lam U → Lam (∁ U)
    ldisj : ∀ {U : ℕ → Pred} → (∀ n → Lam (U n)) → Disjoint U → Lam (λ x → Σ ℕ (λ n → U n x))
    lresp : ∀ {U V} → U ≐ V → Lam U → Lam V

  Lam-⊤ : Lam ⊤ᵖ
  Lam-⊤ = lcyl cylTop

  Lam-⊥ : Lam ⊥ᵖ
  Lam-⊥ = lresp (λ x → (λ f → f tt) , (λ b _ → b)) (lcompl Lam-⊤)

  -- binary disjoint unions, as the sequence U, V, ∅, ∅, …
  seq₂ : Pred → Pred → ℕ → Pred
  seq₂ U V zero = U
  seq₂ U V (suc zero) = V
  seq₂ U V (suc (suc _)) = ⊥ᵖ

  seq₂-lam : ∀ {U V} → Lam U → Lam V → ∀ n → Lam (seq₂ U V n)
  seq₂-lam lu lv zero = lu
  seq₂-lam lu lv (suc zero) = lv
  seq₂-lam lu lv (suc (suc _)) = Lam-⊥

  seq₂-disj : ∀ {U V} → (∀ x → U x → V x → ⊥) → Disjoint (seq₂ U V)
  seq₂-disj d x zero zero _ _ = ≡.refl
  seq₂-disj d x zero (suc zero) u v = ⊥-elim (d x u v)
  seq₂-disj d x (suc zero) zero v u = ⊥-elim (d x u v)
  seq₂-disj d x (suc zero) (suc zero) _ _ = ≡.refl
  seq₂-disj d x zero (suc (suc _)) _ ()
  seq₂-disj d x (suc zero) (suc (suc _)) _ ()
  seq₂-disj d x (suc (suc _)) _ ()
  
  ldisj₂ : ∀ {U V} → Lam U → Lam V → (∀ x → U x → V x → ⊥) → Lam (λ x → U x ⊎ V x)
  ldisj₂ {U} {V} lu lv d = lresp e (ldisj (seq₂-lam lu lv) (seq₂-disj d))
    where
      e : (λ x → Σ ℕ (λ n → seq₂ U V n x)) ≐ (λ x → U x ⊎ V x)
      e x = (λ { (zero , u) → inj₁ u ; (suc zero , v) → inj₂ v ; (suc (suc _) , ()) })
          , (λ { (inj₁ u) → zero , u ; (inj₂ v) → suc zero , v })

  -- the complement of U ∩ P is a disjoint union
  compl-∩ : ∀ {U P} → Lam P → Lam (U ∩ᵖ P) → Lam (∁ U ∩ᵖ P)
  compl-∩ {U} {P} lP lUP = lresp e (lcompl (ldisj₂ (lcompl lP) lUP (λ x np (_ , p) → np p)))
    where
      e : ∁ (λ x → ∁ P x ⊎ (U x × P x)) ≐ (∁ U ∩ᵖ P)
      e x = (λ h → decideP h)  , (λ (nu , p) → λ { (inj₁ np) → np p ; (inj₂ (u , _)) → nu u })
        where
          decideP : ((∁ P x ⊎ (U x × P x)) → ⊥) → ∁ U x × P x
          decideP h with lem (P x)
          ... | inj₁ p = (λ u → h (inj₂ (u , p))) , p
          ... | inj₂ np = ⊥-elim (h (inj₁ np))

  ∩-cong : ∀ {U V P} → U ≐ V → (U ∩ᵖ P) ≐ (V ∩ᵖ P)
  ∩-cong e x = (λ (u , p) → proj₁ (e x) u , p) , (λ (v , p) → proj₂ (e x) v , p)

  ∩-comm : ∀ {U V} → (U ∩ᵖ V) ≐ (V ∩ᵖ U)
  ∩-comm x = (λ (u , v) → v , u) , (λ (v , u) → u , v)

  -- the λ-system is closed under intersection with cylinders …
  step₁ : ∀ {P} → Cyl P → ∀ {U} → Lam U → Lam (U ∩ᵖ P)
  step₁ cP (lcyl cU) = lcyl (Cyl-∩ cU cP)
  step₁ cP (lcompl l) = compl-∩ (lcyl cP) (step₁ cP l)
  step₁ {P} cP (ldisj {Uₙ} ls dj) = lresp e (ldisj (λ n → step₁ cP (ls n)) dj′)
    where
      e : (λ x → Σ ℕ (λ n → Uₙ n x ×  P x)) ≐ ((λ x → Σ ℕ (λ n → Uₙ n x)) ∩ᵖ P)
      e x = (λ { (n , u , p) → (n , u) , p }) , (λ { ((n , u) , p) → n , u , p })
      dj′ : Disjoint (λ n x → Uₙ n x × P x)
      dj′ x m n (um , _) (un , _) = dj x m n um un
  step₁ cP (lresp e l) = lresp (∩-cong e) (step₁ cP l)

  -- … and then with every member of the λ-system
  step₂ : ∀ {V} → Lam V → ∀ {U} → Lam U → Lam (U ∩ᵖ V)
  step₂ (lcyl cV) lU = step₁ cV lU
  step₂ (lcompl {V′} l) {U} lU =
    lresp (λ x → (λ (nv , u) → u , nv) , (λ (u , nv) → nv , u))
      (compl-∩ lU (lresp ∩-comm (step₂ l lU)))
  step₂ (ldisj {Vₙ} ls dj) {U} lU = lresp e (ldisj (λ n → step₂ (ls n) lU) dj′)
    where
      e : (λ x → Σ ℕ (λ n → U x × Vₙ n x)) ≐ (U ∩ᵖ (λ x → Σ ℕ (λ n → Vₙ n x)))
      e x = (λ { (n , u , v) → u , n , v }) , (λ { (u , n , v) → n , u , v })
      dj′ : Disjoint (λ n x → U x × Vₙ n x)
      dj′ x m n (_ , vm) (_ , vn) = dj x m n vm vn
  step₂ (lresp e l) lU =
    lresp (λ x → (λ (u , v) → u , proj₁ (e x) v) , (λ (u , v′) → u , proj₂ (e x) v′)) (step₂ l lU)

  Lam-∩ : ∀ {U V} → Lam U → Lam V → Lam (U ∩ᵖ V)
  Lam-∩ lU lV = step₂ lV lU

  Lam-∪ : ∀ {A B} → Lam A → Lam B → Lam (λ x → A x ⊎ B x)
  Lam-∪ {A} {B} lA lB = lresp e (lcompl (Lam-∩ (lcompl lA) (lcompl lB)))
    where
      e : ∁ (∁ A ∩ᵖ ∁ B) ≐ (λ x → A x ⊎ B x)
      e x = (λ h → dec h)
          , (λ { (inj₁ a) → λ (na , _) → na a ; (inj₂ b) → λ (_ , nb) → nb b })
        where
          dec : ((∁ A x × ∁ B x) → ⊥) → A x ⊎ B x
          dec h with lem (A x)
          ... | inj₁ a = inj₁ a
          ... | inj₂ na with lem (B x)
          ...   | inj₁ b = inj₂ b
          ...   | inj₂ nb = ⊥-elim (h (na , nb))

  -- finite unions U 0 ∪ … ∪ U (n-1)
  Fin∪ : (ℕ → Pred) → ℕ → Pred
  Fin∪ U zero = ⊥ᵖ
  Fin∪ U (suc n) x = Fin∪ U n x ⊎ U n x

  Lam-Fin∪ : ∀ {U : ℕ → Pred} → (∀ n → Lam (U n)) → ∀ n → Lam (Fin∪ U n)
  Lam-Fin∪ ls zero = Lam-⊥
  Lam-Fin∪ ls (suc n) = Lam-∪ (Lam-Fin∪ ls n) (ls n)

  Fin∪-inv : ∀ (U : ℕ → Pred) n x → Fin∪ U n x → Σ ℕ (λ k → (k ℕ.< n) × U k x)
  Fin∪-inv U zero x ()
  Fin∪-inv U (suc n) x (inj₁ f) with Fin∪-inv U n x f
  ... | k , k<n , u = k , ℕₚ.<-trans k<n (ℕₚ.n<1+n n) , u
  Fin∪-inv U (suc n) x (inj₂ u) = n , ℕₚ.n<1+n n , u

  Fin∪-mono : ∀ (U : ℕ → Pred) {m n x} → m ℕ.< n → U m x → Fin∪ U n x
  Fin∪-mono U {m} {suc n} {x} (ℕ.s≤s m≤n) u with ℕₚ.m≤n⇒m<n∨m≡n m≤n
  ... | inj₁ m<n = inj₁ (Fin∪-mono U m<n u)
  ... | inj₂ ≡.refl = inj₂ u

  -- countable (not nec. disjoint) unions, by disjointification
  Lam-⋃ : ∀ {U : ℕ → Pred} → (∀ n → Lam (U n)) → Lam (λ x → Σ ℕ (λ n → U n x))
  Lam-⋃ {U} ls = lresp e (ldisj (λ n → Lam-∩ (ls n) (lcompl (Lam-Fin∪ ls n))) disj)
    where
      F : ℕ → Pred
      F n x = U n x × (Fin∪ U n x → ⊥)

      disj : Disjoint F
      disj x m n (um , nm) (un , nn) with ℕₚ.<-cmp m n
      ... | tri< m<n _ _ = ⊥-elim (nn (Fin∪-mono U m<n um))
      ... | tri≈ _ eq _ = eq
      ... | tri> _ _ n<m = ⊥-elim (nm (Fin∪-mono U n<m un))

      first : ∀ n x → U n x → Σ ℕ (λ m → F m x)
      first n x u = Data.Nat.Induction.<-rec (λ n → ∀ x → U n x → Σ ℕ (λ m → F m x)) step n x u
        where
          step : ∀ n → (∀ {k} → k ℕ.< n → ∀ x → U k x → Σ ℕ (λ m → F m x)) → ∀ x → U n x → Σ ℕ (λ m → F m x)
          step n ih x u with lem (Fin∪ U n x)
          ... | inj₁ f with Fin∪-inv U n x f
          ...   | k , k<n , uk = ih k<n x uk
          step n ih x u | inj₂ nf = n , u , nf

      e : (λ x → Σ ℕ (λ n → F n x)) ≐ (λ x → Σ ℕ (λ n → U n x))
      e x = (λ { (n , u , _) → n , u }) , (λ { (n , u) → first n x u })

  -- every Borel set is in the λ-system
  borel⊆lam : ∀ {U} → Borel U → Lam U
  borel⊆lam (gen n b) = lresp (λ x → (λ (_ , e) → e) , (λ e → tt , e)) (lcyl (cylAnd cylTop n b))
  borel⊆lam (compl bu) = lcompl (borel⊆lam bu)
  borel⊆lam (⋃ bs) = Lam-⋃ (λ n → borel⊆lam (bs n))
  borel⊆lam (⋂ {U} bs) = lresp e (lcompl (Lam-⋃ (λ n → lcompl (borel⊆lam (bs n)))))
    where
      e : ∁ (λ x → Σ ℕ (λ n → ∁ (U n) x)) ≐ (λ x → ∀ n → U n x)
      e x = (λ h n → dec h n) , (λ all (n , nu) → nu (all n))
        where
          dec : ((Σ ℕ (λ n → ∁ (U n) x)) → ⊥) → ∀ n → U n x
          dec h n with lem (U n x)
          ... | inj₁ u = u
          ... | inj₂ nu = ⊥-elim (h (n , nu))
  borel⊆lam (resp e bu) = lresp e (borel⊆lam bu)

  -- Dynkin's π–λ theorem
  dynkin : (D : Pred → Set₁) →
    (∀ {U V} → U ≐ V → D U → D V) →
    (∀ {U} → Cyl U → D U) →
    (∀ {U} → D U → D (∁ U)) →
    (∀ {U : ℕ → Pred} → (∀ n → D (U n)) → Disjoint U → D (λ x → Σ ℕ (λ n → U n x))) →
    ∀ {U} → Borel U → D U
  dynkin D dresp dcyl dcompl ddisj bu = lam⊆D (borel⊆lam bu)
    where
      lam⊆D : ∀ {U} → Lam U → D U
      lam⊆D (lcyl c) = dcyl c
      lam⊆D (lcompl l) = dcompl (lam⊆D l)
      lam⊆D (ldisj ls dj) = ddisj (λ n → lam⊆D (ls n)) dj
      lam⊆D (lresp e l) = dresp e (lam⊆D l)
