{-# OPTIONS --safe --without-K #-}

-- QBS generated by a presheaf of pieces (`GluedQBS`), the common shape of sums, coequalizers and indexed sums.
module QBS.Glued where

open import Level using (lower; lift)
open import Function.Bundles using (Func; _⟨$⟩_)
open import Function.Base using (const)
open import Data.Nat.Base using (ℕ)
open import Data.Product.Base using (Σ; _×_; _,_; proj₁; proj₂)
open import Relation.Binary.Bundles using (Setoid)
open import Relation.Binary.PropositionalEquality.Core using (sym; subst)
open import Categories.Category.Instance.Setoids using (Setoids)
open import Categories.Category.SubCategory using (SubCat)

import Categories.Category.SubCategory.SubHom as SH

open import QBS.Core
open import QBS.Pieces

module _ {ℓ} (S : RandomSource ℓ) where
  open RandomSource S
  open SH (Setoids ℓ ℓ) using (_∈_; mem; probe; reads; ∈-resp; ∈-pre)
  open QBS

  -- The QBS generated by a presheaf of pieces: α is random iff, locally on a measurable countable
  -- partition i, it is a piece, α r ≈ ev (c (i r)) r.  Here P is the set of pieces, ev reads a piece off as a
  -- map Rˢ → Z, `pre` precomposes a piece with a measurable map (`ev-pre`), and every point is a constant piece.
  -- This is the sheaf generated by a presheaf (for the coverage of countable partitions); compare Heunen,
  -- Kammar, Staton, Yang, LICS 2017, "A convenient category for higher-order probability theory".
  -- The sums, coequalizers and indexed sums are all of this form.  The pieces of the result are the locally
  -- given pieces `(i , idx , c)`, read off by `glueₛ`.
  GluedQBS : (Z : Setoid ℓ ℓ) (P : Set ℓ) (ev : P → Func Rˢ Z) →
    (pre : ∀ {f} → P → Meas f → P) →
    (ev-pre : ∀ {f} (c : P) (m : Meas f) r → Setoid._≈_ Z (ev (pre c m) ⟨$⟩ r) (ev c ⟨$⟩ (f ⟨$⟩ r))) →
    (pt : ∀ z → Σ P λ c → ∀ r → Setoid._≈_ Z (ev c ⟨$⟩ r) z) → QBS S
  GluedQBS Z P ev pre ev-pre pt = record
    { Carrier = Z
    ; probes = fromPieces measurable Z Local (λ (i , _ , c) → glueₛ i (λ n → ev (c n)))
        (λ {f} (i , ii , c) m → i ∘ₛ f , idx-pre ii (meas₀ m) , λ n → pre (c n) (meas₀ m))
        (λ {f} (i , ii , c) m r → ev-pre (c (lower (i ⟨$⟩ (f ⟨$⟩ r)))) (meas₀ m) r)
        (λ z → (constₛ (lift 0) , idx-const (lift 0) , const (proj₁ (pt z))) , proj₂ (pt z))
    ; glue-random = λ {j} ij α p →
        let q = λ n → probe (p n)
            i = λ n → proj₁ (q n)
            c = λ n → proj₂ (proj₂ (q n))
            ref = common-refinement ij (λ n → proj₁ (proj₂ (q n)))
            u = proj₁ (proj₂ (proj₂ ref))
            c′ = λ m → c (proj₁ (u m)) (proj₂ (u m))
        in mem (proj₁ ref , proj₁ (proj₂ ref) , c′)
             (λ {r} → subst (λ u → (ev (c (proj₁ u) (proj₂ u)) ⟨$⟩ r) ≈ᶻ (α (lower (j ⟨$⟩ r)) ⟨$⟩ r))
                            (sym (proj₂ (proj₂ (proj₂ ref)) r))
                            (reads (p (lower (j ⟨$⟩ r))) {r}))
    }
    where
      _≈ᶻ_ = Setoid._≈_ Z
      Local : Set ℓ
      Local = Σ (Func Rˢ ℕˢ) λ i → Idx i × (ℕ → P)

